// PUMP&DUMP double-barrel shotgun. Like movement.ron, the game reloads this file
// when you save it.
//
// Units: game units (~1 inch), seconds, degrees.
(
    // One shell per barrel; one barrel per click.
    barrels: 2,
    // A shot is this many pellets, evenly filling a cone of this half-angle.
    pellets: 12,
    spread_deg: 5.5,
    // Dummies have 100 health, so a close-range shot (most pellets hit) kills.
    pellet_damage: 12.0,
    range: 6000.0,
    // Seconds between the first barrel and the second.
    refire_time: 0.22,
    // Seconds to break it open and load both barrels.
    reload_time: 1.15,
)
